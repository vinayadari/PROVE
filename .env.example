# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://your-neon-project-id.neon.tech
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-chars-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Model (xAI Grok)
XAI_API_KEY=xai-your-api-key-here

# Optional: GitHub token for enhanced rate limits when fetching public evidence
GITHUB_TOKEN=
